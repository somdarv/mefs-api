APP_NAME=mefs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# NOTE: there is deliberately no APP_TIMEZONE here. UTC is hardcoded in config/app.php
# because it is a requirement, not a preference — Accra is UTC+0 all year with no DST, so
# server time IS kitchen time. An env var would imply it is safe to change. It is not.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL in EVERY environment, including tests (brief §11.2). SQLite folds LIKE case
# and cannot parse EXTRACT — a green SQLite suite does not prove the Postgres path.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mefs
DB_USERNAME=mefs
DB_PASSWORD=

# The suite runs against this database; phpunit.xml points at it.
DB_TEST_DATABASE=mefs_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@mefs.local"
MAIL_FROM_NAME="${APP_NAME}"

# The Next.js storefront and back office. Sanctum needs it for stateful/CORS purposes.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ── Paystack ──────────────────────────────────────────────────────────────────
# Test keys from the Paystack dashboard. The webhook secret IS the secret key —
# Paystack signs with HMAC-SHA512 over the raw body using it.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Paystack refuses a reserved TLD (.local/.test). Must be a real, resolvable domain.
PAYSTACK_ORDER_EMAIL_DOMAIN=
# Seconds the tracking page waits on an unanswered mobile money prompt before
# offering to send another. Nothing at Paystack's end expires on this clock.
PAYSTACK_PROMPT_TTL=300

# ── SMS (SMSOnlineGH) ─────────────────────────────────────────────────────────
# Paystack does payments only; order confirmations, cutoff nudges and "your food is
# ready" go through SMSOnlineGH. `log` writes messages to the log instead of sending,
# which is what local and CI should use — nobody wants a test suite texting customers.
SMS_DRIVER=log
SMSONLINEGH_API_KEY=
SMSONLINEGH_SENDER_ID=MefsCuisine
SMSONLINEGH_BASE_URL=https://api.smsonlinegh.com
