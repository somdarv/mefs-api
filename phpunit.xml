<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            PostgreSQL, never SQLite (brief §11.2). SQLite folds LIKE case and cannot parse
            EXTRACT, so a green SQLite suite does not prove the Postgres path. The original's
            suite failed 3-6 tests depending on the wall-clock hour for exactly that reason —
            a drop in failures meant the clock had moved, not that anything was fixed.

            Requires the `mefs_testing` database to exist. See README.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="mefs_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!--
            A test suite must never text a real customer, and the guarantee is not that
            somebody remembers to set an env var. Pinned here, and `AppServiceProvider`
            falls back to the log driver anyway whenever credentials are missing.
        -->
        <env name="SMS_DRIVER" value="log"/>
        <env name="SMSONLINEGH_API_KEY" value=""/>
        <!--
            ⚠️ BLANK ON PURPOSE, AND THE SUITE IS WRONG WITHOUT IT. Several tests assert what
            happens with NO gateway configured — the webhook returning 503 rather than
            accepting an unverifiable write — and they were reading whatever the developer
            happened to have in `.env`. The moment a real key landed there, the suite went red
            on a test about the opposite situation. Tests that need keys call `withKeys()`.

            Same reasoning as SMSONLINEGH_API_KEY above, which had already learnt it.
        -->
        <env name="PAYSTACK_SECRET_KEY" value=""/>
        <env name="PAYSTACK_PUBLIC_KEY" value=""/>
        <env name="PAYSTACK_ORDER_EMAIL_DOMAIN" value="example.com"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
